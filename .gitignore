# Large MATLAB raw outputs belong in an external data package.
results/data/*.mat
results/data/stage4a3_1_cache/*.mat
results/data/stage4a4_cache/*.mat
results/data/stage4a5_1_cache/*.mat
results/data/stage4a6_3/*.mat
results/data/stage4a6_3/runs/
results/data/stage4a6_3_1_r/cache/
results/data/stage4a6_3_1_r/*.mat
results/data/stage4a6_3_1_r/calibration/*.mat
results/data/stage4a6_3_1_r/pilot/*.mat
results/logs/stage4a6_3/final_batch_*.log
results/logs/stage4a6_3/final_resume_*.log
results/logs/stage4a6_3/failure_*.log
results/logs/stage4a6_3/single_case_error_stack.log
results/logs/stage4a6_3/final_bank_count.log
results/data/stage2_3_partial_*
results/data/stage2_3_smoke_*
!results/data/stage2_3_smoke_fixed_*.csv
results/data/stage2_3_formal_fixed_trials.csv
/results/data/stage4a_freeze_r1_1/
/results/logs/stage4a_freeze_r1_1/

# Local Stage 4A development outputs. The canonical freeze artifacts that are
# already tracked remain tracked; repeated runs, caches, figures, and logs do
# not belong in normal source commits.
/results/data/stage4a5*
/results/data/stage4a6*
/results/data/stage4a7_1*
/results/data/stage4a7_2*
/results/logs/stage4a*
/results/figures/stage4a*
/tmp/

# Stage 5B.1 detailed outputs are reproducible but can grow quickly. Keep only
# the compact formal summary tables under version control.
/results/data/stage5b1/smoke/
/results/data/stage5b1/formal/candidate_confidence.csv
/results/data/stage5b1/formal/candidate_margin.csv
/results/data/stage5b1/formal/enhanced_decision_summary.csv
/results/data/stage5b1/formal/stage5b1_results.mat
/results/logs/stage5b1_*.log

# Stage 6 smoke outputs are local protocol checks. Keep the compact formal
# CSV/MAT summaries and Stage 6B review figures under version control.
/results/data/stage6a/smoke/
/results/data/stage6b/smoke/
/results/figures/stage6b/smoke/

# Stage 7A.3: archive compact formal evidence; regenerate large sample tables.
/results/data/stage7a_3/*.csv
/results/data/stage7a_3/*.mat
/results/data/stage7a_3/smoke/
/results/data/stage7a_3/formal/stage7a3_candidate_distances.csv
/results/data/stage7a_3/formal/stage7a3_sample_diagnostics.csv
/results/data/stage7a_3/formal/stage7a3_residual_spectra.csv
/results/logs/stage7a_3/*.log
!/results/logs/stage7a_3/stage7a3_formal_separated_final.log
!/results/logs/stage7a_3/stage7a3_smoke_separated_final.log
!/results/logs/stage7a_3/stage7a3_historical_regression.log

# Stage 7A.4: keep compact formal evidence and verification logs in Git;
# regenerate large per-sample and smoke tables with the independent entrypoint.
/results/data/stage7a_4/smoke/
/results/data/stage7a_4/formal/stage7a4_samples.csv
/results/logs/stage7a_4/*.log
!/results/logs/stage7a_4/stage7a4_final_reproduction.log
!/results/logs/stage7a_4/stage7a4_related_regression.log
!/results/logs/stage7a_4/stage7a4_full_regression.log
!/results/logs/stage7a_4/stage7a4_clean_baseline_full_regression_final.log

# Stage 7A.4-R.1/R.2: archive compact formal evidence and verification logs.
# Full per-sample and smoke outputs are locally reproducible, not Git inputs.
/results/data/stage7a_4_resolution/smoke/
/results/data/stage7a_4_resolution/formal/resolution_samples.csv
/results/data/stage7a_4_continuous/smoke/
/results/data/stage7a_4_continuous/formal/continuous_samples.csv

# Stage 7A.4 original 15 m continuous audit: archive compact formal tables;
# regenerate per-sample and smoke outputs with the independent entrypoint.
/results/data/stage7a_4_15m_continuous/smoke/
/results/data/stage7a_4_15m_continuous/formal/samples.csv
